<?xml version="1.0" encoding="UTF-8"?>
<config>
  <udpPort>30169</udpPort>
  <!-- Raw OpticScore resend to another dashboard: host:port or a bare port (127.0.0.1). Empty = off. -->
  <udpForward/>
  <odbcName>SRDashboard_Access_DSN</odbcName>
  <ranges>8</ranges>
  <layoutColumns>4</layoutColumns>
  <footer>
    <currentShotValue>true</currentShotValue>
    <teiler>true</teiler>
    <shotNumber>true</shotNumber>
    <overallSumInt>true</overallSumInt>
    <overallSumDecimal>true</overallSumDecimal>
    <predictionInt>true</predictionInt>
    <predictionDecimal>true</predictionDecimal>
    <seriesSumsInt>true</seriesSumsInt>
    <seriesSumsDecimal>true</seriesSumsDecimal>
    <last10Int>true</last10Int>
    <last10Decimal>true</last10Decimal>
  </footer>
  <plugins dir="plugins" active="classic-range"/>
  <display>
    <!-- Pellet outline width in mm (SVG units). Typical: 0.06–0.12; clubs often disagree. -->
    <shotStrokeWidth>0.1</shotStrokeWidth>
    <defaultMode>master</defaultMode>
    <controlToken/>
    <!-- Full-control LAN port (PORT env overrides). -->
    <adminPort>8080</adminPort>
    <!-- Read-only master+stands for publish/proxy; 0 = off. -->
    <publicPort>0</publicPort>
  </display>
</config>
